# Groq
GROQ_API_TOKEN=your_groq_api_token_here

# Models
QWEN_MODEL=qwen/qwen3-32b
LLAMA_MODEL=llama-3.3-70b-versatile
SQL_GENERATOR_MODEL=llama-3.3-70b-versatile
INSIGHTS_MODEL=qwen/qwen3-32b

# Reliability / token control
PARSE_INTENT_MAX_RETRIES=2
PARSE_INTENT_MODE=adaptive
PARSE_INTENT_USE_INSTRUCTOR=1
AI_INSIGHTS_MODE=adaptive
AI_INSIGHTS_ROW_THRESHOLD=8

# DuckDB
DUCKDB_PATH=motia/data/analytics.duckdb

# Redis cache (optional)
REDIS_URL=redis://localhost:6379/0

# Chroma SQL memory (optional)
CHROMA_ENABLED=1
CHROMA_PATH=./motia/data/chroma
CHROMA_COLLECTION=sql_memory

# MLflow tracking (optional)
MLFLOW_ENABLED=1
MLFLOW_TRACKING_URI=file:./motia/data/mlruns
MLFLOW_EXPERIMENT=sales_forecasting

# dbt post-ingest hook (optional)
DBT_AUTO_RUN=0
DBT_PROJECT_DIR=./dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# FastAPI websocket bridge
WS_BRIDGE_URL=http://localhost:8001
MOTIA_API_BASE_URL=http://localhost:3121
